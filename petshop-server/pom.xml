<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.3.5</version>
    <relativePath/>
  </parent>

  <groupId>cn.petshop</groupId>
  <artifactId>petshop-server</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>petshop-server</name>

  <modules>
    <module>petshop-common</module>
    <module>petshop-wallet</module>
    <module>petshop-member</module>
    <module>petshop-booking</module>
    <module>petshop-mall</module>
    <module>petshop-settle</module>
    <module>petshop-admin</module>
  </modules>

  <properties>
    <java.version>21</java.version>
    <mybatis-plus.version>3.5.7</mybatis-plus.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.baomidou</groupId>
        <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
        <version>${mybatis-plus.version}</version>
      </dependency>
      <dependency>
        <groupId>cn.petshop</groupId>
        <artifactId>petshop-common</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>cn.petshop</groupId>
        <artifactId>petshop-wallet</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>cn.petshop</groupId>
        <artifactId>petshop-member</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>cn.petshop</groupId>
        <artifactId>petshop-booking</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>cn.petshop</groupId>
        <artifactId>petshop-mall</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>cn.petshop</groupId>
        <artifactId>petshop-settle</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>
</project>
