<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>cn.petshop</groupId>
    <artifactId>petshop-server</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>
  <artifactId>petshop-admin</artifactId>
  <name>petshop-admin</name>

  <dependencies>
    <dependency>
      <groupId>cn.petshop</groupId>
      <artifactId>petshop-common</artifactId>
    </dependency>
    <dependency>
      <groupId>cn.petshop</groupId>
      <artifactId>petshop-wallet</artifactId>
    </dependency>
    <dependency>
      <groupId>cn.petshop</groupId>
      <artifactId>petshop-member</artifactId>
    </dependency>
    <dependency>
      <groupId>cn.petshop</groupId>
      <artifactId>petshop-booking</artifactId>
    </dependency>
    <dependency>
      <groupId>cn.petshop</groupId>
      <artifactId>petshop-mall</artifactId>
    </dependency>
    <dependency>
      <groupId>cn.petshop</groupId>
      <artifactId>petshop-settle</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!--
      本地演示 / 联调：把 H2 从 test 作用域提到 runtime。

      为什么需要这个 profile：
      H2 平时是 test 作用域的（只给单元测试用），所以 `spring-boot:run` 拿不到它 ——
      想在本机把应用起起来就必须先有一个跑着的 MySQL。而演示、截图、给同事看效果
      这些场景都不该依赖"先把数据库装好"。

      只在显式加 -Pdemo 时生效，生产打包（不带该 profile）里不会多出 H2，
      jar 体积与依赖面都不受影响。

      用法：
        mvn -o -Pdemo -pl petshop-admin spring-boot:run
    -->
    <profile>
      <id>demo</id>
      <dependencies>
        <dependency>
          <groupId>com.h2database</groupId>
          <artifactId>h2</artifactId>
          <scope>runtime</scope>
        </dependency>
      </dependencies>
    </profile>
  </profiles>
</project>
