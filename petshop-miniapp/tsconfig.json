{
  "compilerOptions": {
    "strict": true,
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    "lib": ["ES2020"],
    "outDir": "miniprogram",
    "rootDir": "miniprogram",
    "typeRoots": ["./node_modules"],
    "types": ["miniprogram-api-typings"],
    "noEmitOnError": true,
    "experimentalDecorators": true,
    "skipLibCheck": true
  },
  "include": ["miniprogram/**/*.ts"],
  "exclude": ["node_modules"]
}
