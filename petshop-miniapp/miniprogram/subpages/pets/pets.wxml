<view class="page theme-{{theme}}">
  <view class="card pet-card" wx:for="{{pets}}" wx:key="id">
    <view class="pet-avatar">{{item.type === 'CAT' ? '🐱' : '🐶'}}</view>
    <view class="pet-info">
      <view class="pet-name">{{item.name}}</view>
      <view class="pet-sub">{{item.type === 'CAT' ? '猫猫' : '狗狗'}} · {{item.hair === 'LONG' ? '长毛' : item.hair === 'MEDIUM' ? '中长毛' : '短毛'}}{{item.weight ? ' · ' + item.weight + 'kg' : ''}}</view>
    </view>
    <view class="pet-actions">
      <view class="mini-btn" data-id="{{item.id}}" bindtap="openEdit">编辑</view>
      <view class="mini-btn danger" data-id="{{item.id}}" bindtap="remove">删除</view>
    </view>
  </view>

  <view wx:if="{{pets.length === 0}}" class="empty">
    <text class="empty-icon">🐾</text>
    还没有宠物档案
  </view>

  <view class="btn-primary" bindtap="openAdd">+ 添加宠物</view>

  <!-- 编辑/新增弹层 -->
  <!-- 遮罩 bindtap 关弹层；弹层本体必须 catchtap 一个**真实存在**的空函数来挡住冒泡。
       catchtap="" 是无效写法 —— 事件照样冒泡到遮罩，点输入框的瞬间弹层就被关掉，
       表现就是「点不进输入框、没法打字」；picker 也会在原生选择器弹起的同时把弹层关掉。 -->
  <view class="mask" wx:if="{{showForm}}" bindtap="closeForm">
    <view class="sheet" catchtap="noop">
      <view class="sheet-title">{{editingId ? '编辑宠物' : '添加宠物'}}</view>
      <view class="form-row">
        <text class="form-label">名字</text>
        <input class="form-input" placeholder="如：团子" value="{{form.name}}" data-field="name" bindinput="onInput" />
      </view>
      <view class="form-row">
        <text class="form-label">类型</text>
        <picker range="{{['猫猫', '狗狗']}}" value="{{form.type === 'CAT' ? 0 : 1}}" bindchange="onType">
          <view class="form-picker">{{form.type === 'CAT' ? '猫猫' : '狗狗'}}</view>
        </picker>
      </view>
      <view class="form-row" wx:if="{{form.type === 'CAT'}}">
        <text class="form-label">毛长</text>
        <picker range="{{['短毛', '中长毛', '长毛']}}" value="{{form.hair === 'SHORT' ? 0 : form.hair === 'MEDIUM' ? 1 : 2}}" bindchange="onHair">
          <view class="form-picker">{{form.hair === 'SHORT' ? '短毛' : form.hair === 'MEDIUM' ? '中长毛' : '长毛'}}</view>
        </picker>
      </view>
      <view class="form-row">
        <text class="form-label">体重(kg)</text>
        <input class="form-input" type="digit" placeholder="选填" value="{{form.weight}}" data-field="weight" bindinput="onInput" />
      </view>
      <button class="btn-primary" bindtap="save">保存</button>
    </view>
  </view>
</view>
