<view class="page theme-{{theme}}">
  <view class="tab-bar">
    <view
      class="tab {{activeTab === item.key ? 'on' : ''}}"
      wx:for="{{tabs}}"
      wx:key="key"
      data-key="{{item.key}}"
      bindtap="pickTab"
    >{{item.name}}</view>
  </view>

  <view class="card appt-card" wx:for="{{rows}}" wx:key="id">
    <view class="appt-head">
      <view class="appt-service">{{item.serviceName}}</view>
      <view class="status {{item.statusCls}}">{{item.statusText}}</view>
    </view>
    <view class="appt-line">🐾 {{item.petName}} · {{item.slotDate}} {{item.startTime}}</view>
    <view class="appt-line muted">{{item.guaranteeText}} · ¥{{item.price}}</view>

    <view class="code-row" wx:if="{{item.status === 'PENDING'}}" data-code="{{item.verifyCode}}" bindtap="copyCode">
      <text>核销码 {{item.verifyCode}}</text>
      <text class="code-copy">复制</text>
    </view>

    <view class="appt-actions" wx:if="{{item.status === 'PENDING'}}">
      <view class="mini-btn primary" wx:if="{{item.canSelfConfirm}}" data-id="{{item.id}}" bindtap="confirmToStore">我已到店</view>
      <view class="mini-btn danger" data-id="{{item.id}}" bindtap="cancel">取消预约</view>
    </view>
  </view>

  <view wx:if="{{rows.length === 0 && !loading}}" class="empty">
    <text class="empty-icon">📅</text>
    暂无预约记录
  </view>
</view>
