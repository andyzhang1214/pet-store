.tab-bar {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
  flex-wrap: wrap;
}
.tab {
  padding: 12rpx 32rpx;
  border-radius: 999rpx;
  background: var(--card);
  font-size: 26rpx;
  color: var(--muted);
}
.tab.on { background: var(--brand); color: #fff; }

.appt-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12rpx; }
.appt-service { font-size: 32rpx; font-weight: 700; color: var(--ink); }

.status { font-size: 24rpx; padding: 6rpx 20rpx; border-radius: 999rpx; }
.status.ok { background: #EAF7E0; color: #389E0D; }
.status.warn { background: #FFF7E0; color: #B27B00; }
.status.info { background: #E6F4FF; color: #1677FF; }
.status.danger { background: #FFECE8; color: #CF1322; }
.status.muted { background: var(--card-muted); color: var(--muted); }

.appt-line { font-size: 26rpx; color: var(--ink); margin-top: 8rpx; }
.appt-line.muted { color: var(--muted); font-size: 24rpx; }

.code-row {
  margin-top: 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: var(--card-muted);
  border-radius: var(--radius-sm);
  padding: 20rpx 24rpx;
  font-size: 26rpx;
  color: var(--brand-text);
  font-weight: 600;
}
.code-copy { font-size: 22rpx; color: var(--muted); font-weight: 400; }

.appt-actions { display: flex; justify-content: flex-end; gap: 16rpx; margin-top: 20rpx; }
.mini-btn {
  font-size: 24rpx;
  color: var(--brand-text);
  background: var(--brand-soft);
  border-radius: 999rpx;
  padding: 10rpx 32rpx;
  border: 2rpx solid transparent;
}
.mini-btn.primary { color: #fff; background: var(--brand); font-weight: 600; }
.mini-btn.danger {
  font-size: 24rpx;
  color: var(--danger);
  border: 2rpx solid var(--danger);
  border-radius: 999rpx;
  padding: 10rpx 32rpx;
}
