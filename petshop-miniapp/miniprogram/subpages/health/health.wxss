.pet-strip { white-space: nowrap; margin-bottom: 24rpx; }
.pet-chip {
  display: inline-block;
  padding: 14rpx 32rpx;
  border-radius: 999rpx;
  background: var(--card);
  font-size: 26rpx;
  color: var(--muted);
  margin-right: 16rpx;
}
.pet-chip.on { background: var(--brand); color: #fff; }

/* 到期看板 */
.due-grid { display: flex; flex-direction: column; gap: 20rpx; margin-bottom: 24rpx; }
.due-card {
  background: var(--card);
  border-radius: var(--radius);
  padding: 28rpx 32rpx;
}
.due-head { display: flex; align-items: center; gap: 12rpx; }
.due-icon { font-size: 36rpx; }
.due-title { font-size: 30rpx; font-weight: 600; color: var(--ink); flex: 1; }
.due-status { font-size: 24rpx; padding: 6rpx 20rpx; border-radius: 999rpx; }
.due-status.ok { background: #EAF7E0; color: #389E0D; }
.due-status.soon { background: #FFF7E0; color: #B27B00; }
.due-status.overdue { background: #F3E8FF; color: #722ED1; }
.due-status.none { background: var(--card-muted); color: var(--muted); }
.due-desc { font-size: 24rpx; color: var(--muted); margin-top: 12rpx; }

/* 时间轴 */
.tl { display: flex; padding: 20rpx 0; border-bottom: 2rpx solid var(--line); }
.tl:last-child { border-bottom: none; }
.tl-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--brand-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  flex-shrink: 0;
}
.tl-body { margin-left: 24rpx; }
.tl-title { font-size: 28rpx; font-weight: 600; color: var(--ink); }
.tl-sub { font-size: 24rpx; color: var(--muted); margin-top: 6rpx; }
