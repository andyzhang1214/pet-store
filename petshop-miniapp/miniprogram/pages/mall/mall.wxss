.top-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 8rpx 24rpx;
}

.top-title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--ink);
}

.orders-link {
  font-size: 26rpx;
  color: var(--brand-text);
  background: var(--brand-soft);
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
}

.sale-banner {
  background: linear-gradient(135deg, var(--brand) 0%, var(--brand-text) 100%);
  color: #fff;
  font-size: 26rpx;
  border-radius: var(--radius);
  padding: 24rpx 32rpx;
  margin-bottom: 24rpx;
}

/* 横向滚动分类条：分类数量由服务端数据决定，可能很多，不能换行挤压布局 */
.cat-bar {
  white-space: nowrap;
  margin-bottom: 24rpx;
}

.cat-item {
  display: inline-block;
  padding: 12rpx 32rpx;
  margin-right: 16rpx;
  border-radius: 999rpx;
  background: var(--card);
  font-size: 26rpx;
  color: var(--muted);
}

.cat-item.on {
  background: var(--brand);
  color: #fff;
  font-weight: 600;
}

.goods-item {
  display: flex;
  gap: 20rpx;
  background: var(--card);
  border-radius: var(--radius);
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(43, 33, 24, 0.04);
}

/* 无图商品用分类名做色块，避免空白占位显得像加载失败 */
.goods-thumb {
  flex: none;
  width: 132rpx;
  height: 132rpx;
  border-radius: var(--radius-sm);
  background: var(--brand-soft);
  color: var(--brand-text);
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.goods-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.goods-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
}

.goods-desc {
  font-size: 24rpx;
  color: var(--muted);
  margin-top: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.goods-foot {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-top: 12rpx;
}

.goods-price {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--brand);
}

.goods-from {
  font-size: 22rpx;
  font-weight: 400;
  color: var(--muted);
}

.goods-stock {
  font-size: 22rpx;
  color: var(--muted);
}

.sold-out {
  font-size: 22rpx;
  color: var(--muted);
  background: var(--card-muted);
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
}
