.hero {
  padding: 48rpx 8rpx 36rpx;
}

.hero-greeting {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--ink);
}

.hero-store {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: var(--muted);
}

/* 主卡：服务预约 */
.main-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: linear-gradient(135deg, var(--brand) 0%, var(--brand-text) 100%);
  border-radius: var(--radius);
  padding: 48rpx 40rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 12rpx 32rpx rgba(184, 85, 29, 0.25);
}

.main-card-title {
  color: #FFFFFF;
  font-size: 40rpx;
  font-weight: 700;
}

.main-card-desc {
  color: rgba(255, 255, 255, 0.85);
  font-size: 24rpx;
  margin-top: 12rpx;
}

.main-card-btn {
  margin-top: 32rpx;
  display: inline-block;
  background: #FFFFFF;
  color: var(--brand-text);
  font-size: 26rpx;
  font-weight: 600;
  padding: 12rpx 36rpx;
  border-radius: 999rpx;
}

.main-card-icon {
  font-size: 110rpx;
  opacity: 0.9;
}

/* 4 小卡 */
.quick-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.quick-item {
  width: calc(50% - 12rpx);
  background: var(--card);
  border-radius: var(--radius);
  padding: 32rpx 28rpx;
  margin-bottom: 24rpx;
  box-sizing: border-box;
  box-shadow: 0 4rpx 16rpx rgba(43, 33, 24, 0.04);
}

.quick-icon { font-size: 56rpx; }

.quick-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
  margin-top: 16rpx;
}

.quick-desc {
  font-size: 24rpx;
  color: var(--muted);
  margin-top: 6rpx;
}
