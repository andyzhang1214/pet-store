    ]
  },

  "goods": {
    "note": "一期上架商品。price_from 仅用于列表页「¥xx 起」，实际成交价取 sku.price。分类是自由文本（非枚举），UI 与小程序一律从服务端数据归并，前端不得自拟分类键。",
    "items": [
      { "id": 301, "name": "宠物香氛沐浴露 500ml", "category": "洗护", "description": "温和低敏，留香 7 天",   "priceFrom": 89.00,
        "skus": [ { "id": 3011, "name": "燕麦香型 500ml",   "price": 89.00, "stock": 100 },
