      { "id": 2, "amount": 500.00,  "gift": 80.00,  "enabled": true },
      { "id": 3, "amount": 1000.00, "gift": 200.00, "enabled": true }
    ],
    "custom": { "enabled": true, "min": 1, "max": 2000, "gift": 0, "note": "自定义金额不享赠送" }
  },

  "memberLevels": {
    "note": "等级数量与门槛完全由门店后台配置，此处为演示门店的实际配置。",
    "levels": [
