        "skus": [ { "id": 3031, "name": "原味 6L", "price": 45.00, "stock": 120 } ] },
      { "id": 304, "name": "宠物洁耳液 120ml",      "category": "护理", "description": "温和清洁耳道，缓解异味",       "priceFrom": 56.00,
        "skus": [ { "id": 3041, "name": "通用型 120ml", "price": 56.00, "stock": 80 } ] },
      { "id": 305, "name": "狗狗磨牙棒 3 支装",     "category": "零食", "description": "耐咬洁齿，牛皮与鸡肉双拼",     "priceFrom": 32.00,
        "skus": [ { "id": 3051, "name": "中型犬 3 支装", "price": 32.00, "stock": 90 } ] },
      { "id": 306, "name": "宠物益生菌 60 粒",      "category": "保健", "description": "调理肠胃，缓解软便",           "priceFrom": 128.00,
        "skus": [ { "id": 3061, "name": "通用款 60 粒", "price": 128.00, "stock": 40 } ] }
    ]
  },

  "refundPolicy": {
    "channel": "BALANCE_ONLY",
    "note": "退款一律退入会员可用余额，即时到账；不提供退微信 / 退现金出口，余额亦不支持提现。赠送金一并退回余额，不折现。",
    "onlineSources": [
      { "bizType": "CARD",   "enabled": true,  "rule": "未使用（remain_times = total_times）且无预扣的次卡，按购卡实付 paid_amount 整卡退回余额" },
      { "bizType": "GOODS",  "enabled": true,  "rule": "已支付且未核销（status = PAID）的商品订单，整单退款；按订单落库时的本金/赠送金快照还原构成，并回补库存。已核销订单不给退" },
      { "bizType": "MANUAL", "enabled": true,  "rule": "店长人工退款，直接生效并留痕" },
      { "bizType": "APPOINT","enabled": false, "rule": "预约担保仅需解冻，无资金需退" },
      { "bizType": "SETTLE", "enabled": false, "rule": "结算链路目前只有扣款方向，无微信渠道分支" }
    ],
    "states": ["APPLYING", "REFUNDED", "REJECTED", "CANCELLED"],
    "noIntermediateState": true,
    "notify": {
      "note": "审核前提醒店长，两条通道并行。推送失败一律静默降级为仅角标，不得影响已提交的退款申请。",
      "channels": [
        { "key": "BADGE", "rule": "后台角标：GET /admin/refunds/pending-count，前端 30s 轮询" },
        { "key": "WX_SUBSCRIBE", "rule": "微信一次性订阅消息，配额制（wx_subscribe_quota）；未配置 appid/secret/模板 ID/店长 openid 时自动跳过" }
      ]
    }
  },

